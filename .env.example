# Exemplo de variáveis para execução local/produção. Copie para seu gerenciador de ambiente;
# não coloque senhas ou tokens reais no Git.
# Render (demo): SPRING_PROFILES_ACTIVE=render. Banco PostgreSQL: prod (exige schema e seed próprios).
SPRING_PROFILES_ACTIVE=render
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nazomocambique
DB_USERNAME=usuario_da_aplicacao
DB_PASSWORD=troque_esta_senha

# Integrações opcionais
ASAAS_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
KEY_ASAAS=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PIX_EXPIRACAO_MINUTOS=60
CORREIOS_ENABLED=false
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CEP_ORIGEM=

